{"id":"f003","tipo":"frase","es":"Estoy harto de esperar.","pt":"Estou de saco cheio de esperar.","aceitas":["estou de saco cheio de esperar","cansei de esperar","estou farto de esperar","nao aguento mais esperar","estou cheio de esperar","to de saco cheio de esperar","estou cansado de esperar","enjoei de esperar"],"distratores":["Estou cheio de comida agora.","Espero ficar farto de comer.","Estou disposto a esperar mais.","Tenho bastante tempo para esperar."],"nivel":"B1","tags":["cotidiano"],"nota":"'Estar harto de' = estar de saco cheio de."},
